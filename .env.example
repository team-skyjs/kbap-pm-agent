# 로컬: cp .env.example .env 후 필요한 값만 채운다. .env는 커밋하지 않는다.
# 기본은 fake 모드: LLM·Amplitude·GitHub를 호출하지 않고 계약서 예시 값으로 응답한다.
AGENT_MODE=fake

# DB (compose가 기본값을 넣는다. 운영은 deploy/kbap-pm-agent.env.example 참고)
DATABASE_URL=mysql://root:root@mysql:3306/kbap_pm_agent
CORS_ORIGINS=http://localhost:5173
# 비우면 인증 검사 끔 (ADR-7)
ACCESS_TOKEN=
# Amplitude OAuth 콜백 URL 생성용
PUBLIC_BASE_URL=http://localhost:8000

# 모델 (ADR-20). "<공급자>:<모델>" 접두사가 런타임을 고른다: anthropic → anthropic SDK, openai → openai-agents.
# 다른 접두사면 real 모드 서버가 뜨지 않는다. OpenAI로 바꾸는 예: AGENT_MODEL=openai:gpt-6-luna
AGENT_MODEL=anthropic:claude-sonnet-5-5
CODE_SUMMARY_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
# openai: 접두사 모델을 쓸 때만 필요
OPENAI_API_KEY=

# 상한 (ADR-2, ADR-16, ADR-9)
AGENT_MAX_TOOL_CALLS=20
AGENT_TIMEOUT_SECONDS=170
LLM_BUDGET_USD=200
# 모델별 단가 덮어쓰기(USD / 1M 토큰). 예: {"gpt-6-luna": [2.5, 10]}
LLM_PRICES=

AMPLITUDE_MCP_URL=https://mcp.amplitude.com/mcp

# 비공개 저장소 클론 (ADR-13)
GITHUB_TOKEN=
REPOS_DIR=/data/repos
TRACK_CALL_PATTERN=track\(EVENTS\.(\w+)
SCREEN_GLOB=src/app/**/*.tsx
# 코드 인덱스·search_code·read_code 대상 (ADR-19)
CODE_GLOB=*.{ts,tsx,js,jsx}

# fake 실행의 이벤트 사이 지연(초). SSE 장시간 검사용
FAKE_DELAY_SECONDS=0.5
