# 수동 배포(폴백) 전용 예시. 정식 배포는 CI가 GitHub Secrets/Variables에서 같은 키를 생성한다 (deploy/README.md)
# 운영(홈서버) env. 레포 루트 .env.prod 로 복사해 채우면 push-and-deploy.sh 가 서버의 kbap-pm-agent.env 로 보낸다.
AGENT_MODE=real
# 같은 docker 네트워크(monitor-net)의 MySQL 컨테이너명. 계정 생성은 deploy/mysql-init.sql
DATABASE_URL=mysql://kbap_pm:<암호>@mysql-prod:3306/kbap_pm_agent
CORS_ORIGINS=https://team-skyjs.github.io
# 공개 API 문지기(ADR-7). 비우면 꺼진다. 프론트 설정 화면에 같은 값을 넣는다
ACCESS_TOKEN=
PUBLIC_BASE_URL=https://pm-agent.simhani1.cloud
# 모델 (ADR-20). "<공급자>:<모델>" 접두사가 런타임을 고른다: anthropic → anthropic SDK, openai → openai-agents.
# 다른 접두사나 빈 값이면 서버가 뜨지 않는다. OpenAI로 바꾸는 예(두 변수 모두 같은 접두사):
#   AGENT_MODEL=openai:gpt-6-luna
#   CODE_SUMMARY_MODEL=openai:gpt-6-luna
AGENT_MODEL=anthropic:claude-sonnet-5-5
CODE_SUMMARY_MODEL=anthropic:claude-haiku-5-5
# anthropic: 접두사 모델을 쓸 때만 필요
ANTHROPIC_API_KEY=
# openai: 접두사 모델을 쓸 때만 필요
OPENAI_API_KEY=
AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_SECONDS=170
LLM_BUDGET_USD=200
AMPLITUDE_MCP_URL=https://mcp.amplitude.com/mcp
GITHUB_TOKEN=
REPOS_DIR=/data/repos
CODE_GLOB=*.{ts,tsx,js,jsx}
