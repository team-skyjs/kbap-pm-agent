# 수동 배포(폴백) 전용 예시. 정식 배포는 CI가 GitHub Secrets/Variables에서 같은 키 생성 (deploy/README.md)
# 레포 루트 .env.prod로 복사해 채우면 push-and-deploy.sh가 서버로 전송. 실제 운영 값은 레포에 쓰지 않음
AGENT_MODE=real
# 같은 docker 네트워크(monitor-net)의 MySQL 컨테이너명. 계정 생성은 deploy/mysql-init.sql
DATABASE_URL=mysql://kbap_pm:<암호>@<MySQL 컨테이너명>:3306/kbap_pm_agent
# 앱 내 공유 토큰. 운영은 Cloudflare Access가 막으므로 비움
ACCESS_TOKEN=
# 운영 호스트명(Amplitude OAuth 콜백 주소 생성용)
PUBLIC_BASE_URL=https://pm-agent.example.com
# 모델. "<공급자>:<모델>" 접두사가 런타임을 고른다: anthropic → anthropic SDK, openai → openai-agents.
# 다른 접두사나 빈 값이면 서버가 뜨지 않는다. OpenAI로 바꾸는 예(두 변수 모두 같은 접두사):
#   AGENT_MODEL=openai:gpt-6-luna
#   CODE_SUMMARY_MODEL=openai:gpt-6-luna
AGENT_MODEL=anthropic:claude-sonnet-5-5
CODE_SUMMARY_MODEL=anthropic:claude-haiku-5-5
# anthropic: 접두사 모델을 쓸 때만 필요
ANTHROPIC_API_KEY=
# openai: 접두사 모델을 쓸 때만 필요
OPENAI_API_KEY=
# 실행 1회의 모델 호출(턴) 상한. 도구 호출은 세지 않는다(병렬 도구 호출 응답도 1턴)
AGENT_MAX_TURNS=10
AGENT_TIMEOUT_SECONDS=170
LLM_BUDGET_USD=200
AMPLITUDE_MCP_URL=https://mcp.amplitude.com/mcp
GITHUB_TOKEN=
REPOS_DIR=/data/repos
CODE_GLOB=*.{ts,tsx,js,jsx}
