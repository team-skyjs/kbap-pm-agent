    classDef out fill:#dbeafe,stroke:#1e40af,color:#111
    classDef ext fill:#e5e7eb,stroke:#374151,color:#111
    class MODEL,LCA,LCO,GRAPH,M,T,SR,AMP,SUM lc
    class TC,TR,FIN,PART,ERR out
    class SDKA,SDKO,MCP ext
